<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<ProjectName>VRT.Downloaders</ProjectName>
		<TargetFrameworks>net10.0-windows10.0.19041.0</TargetFrameworks>
		                  
		<!--<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net9.0-windows10.0.19041.0</TargetFrameworks>-->
		<OutputType>Exe</OutputType>
		<RootNamespace>VRT.Downloaders.Maui</RootNamespace>
		<UseMaui>true</UseMaui>
		<AppVersion>2</AppVersion>
		<AppDisplayVersion>1.1</AppDisplayVersion>
		<SingleProject>true</SingleProject>
		<SatelliteResourceLanguages>none</SatelliteResourceLanguages>
		<NeutralLanguage>en-US</NeutralLanguage>
		
		<!--Source generation testing-->
		<MauiXamlInflator>SourceGen</MauiXamlInflator>
		<!--<MauiStrictXamlCompilation>true</MauiStrictXamlCompilation>
		<MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>-->


		<!-- Display name -->
		<ApplicationTitle>VRT.Downloaders.Maui</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.vrt.downloaders.maui</ApplicationId>		
		<ApplicationIdGuid>61F98820-169A-4A21-8556-77DE06EBBF8B</ApplicationIdGuid>
		<!--<ApplicationIdGuid Condition="'$(Configuration)' == 'Release'">27AB33B7-7AC7-443C-A18E-1BC6077589A2</ApplicationIdGuid>-->

		<!-- Versions -->
		<ApplicationDisplayVersion>$(AppDisplayVersion)</ApplicationDisplayVersion>
		<ApplicationVersion>$(AppVersion)</ApplicationVersion>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">23.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.19041.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.19041.0</TargetPlatformMinVersion>
		<DefaultLanguage>en-us</DefaultLanguage>
		
		<PackageCertificateThumbprint>B139F22CDA17349355689653B61A414629E82FFE</PackageCertificateThumbprint>
		<PackageCertificateKeyFile>VRT.Downloaders.Maui_TemporaryKey.pfx</PackageCertificateKeyFile>
		<AppxPackageSigningEnabled>True</AppxPackageSigningEnabled>
		<WindowsPackageType>None</WindowsPackageType>
		<SelfContained Condition="'$(IsUnpackaged)' == 'true'">true</SelfContained>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>		
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net9.0-android|AnyCPU'">
	  <AndroidKeyStore>False</AndroidKeyStore>
	  <ApplicationDisplayVersion>$(AppDisplayVersion)</ApplicationDisplayVersion>
	  <ApplicationTitle>VRT Downloaders</ApplicationTitle>
	</PropertyGroup>

	<PropertyGroup Label="Trimming">		
		<PublishSingleFile>false</PublishSingleFile>
		<SelfContained>false</SelfContained>
		<WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<UseMonoRuntime>false</UseMonoRuntime>
		<!-- Optional: Use member-level trimming for more aggressive size reduction -->		
	</PropertyGroup>
	
	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net9.0-android|AnyCPU'">
	  <AndroidKeyStore>False</AndroidKeyStore>
	  <ApplicationDisplayVersion>$(AppDisplayVersion)</ApplicationDisplayVersion>
	  <ApplicationTitle>VRT Downloaders</ApplicationTitle>
	  <AndroidPackageFormat>apk</AndroidPackageFormat>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Debug|net9.0-windows10.0.19041.0|AnyCPU'">
	  <ApplicationDisplayVersion>$(AppDisplayVersion)</ApplicationDisplayVersion>
	  <ApplicationTitle>VRT Downloaders</ApplicationTitle>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)|$(Platform)'=='Release|net9.0-windows10.0.19041.0|AnyCPU'">
	  <ApplicationDisplayVersion>$(AppDisplayVersion)</ApplicationDisplayVersion>
	  <ApplicationTitle>VRT Downloaders</ApplicationTitle>
	</PropertyGroup>
	
	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Images\download_icon.svg" Color="#512BD4" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" Resize="false" />

		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<MauiXaml Update="Controls\MediaListItemView.xaml">
		  <Generator>MSBuild:Compile</Generator>
		</MauiXaml>
		<MauiXaml Update="Pages\ErrorPage.xaml">
			<Generator>MSBuild:Compile</Generator>
		</MauiXaml>
	</ItemGroup>
	
	<ItemGroup>
	  <None Include="..\LICENSE.txt" Link="LICENSE.txt">
	    <PackagePath></PackagePath>
	    <Pack>True</Pack>
	  </None>
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Include="CommunityToolkit.Maui" />
	  <PackageReference Include="DependencyPropertyGenerator">
	    <PrivateAssets>all</PrivateAssets>
	    <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
	  </PackageReference>
	  <PackageReference Include="ReactiveUI.Maui" />
	  <PackageReference Include="Microsoft.Maui.Controls" />	  
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\VRT.Downloaders.Core\VRT.Downloaders.Core.csproj" />
	  <ProjectReference Include="..\VRT.Downloaders.Infrastructure\VRT.Downloaders.Infrastructure.csproj" />
	</ItemGroup>

	<ItemGroup>	  
	  <MauiXaml Update="Pages\SettingsPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	</ItemGroup>

	<ItemGroup>
	  <Compile Update="Helpers\FolderHelpers.cs">
	    <ExcludeFromCurrentConfiguration>true</ExcludeFromCurrentConfiguration>
	  </Compile>
	  <Compile Update="Helpers\WindowHelpers.cs">
	    <ExcludeFromCurrentConfiguration>true</ExcludeFromCurrentConfiguration>
	  </Compile>
	  <Compile Update="Platforms\Android\Partials\FolderHelpers.cs">
	    <ExcludeFromCurrentConfiguration>true</ExcludeFromCurrentConfiguration>
	  </Compile>
	  <Compile Update="Platforms\Android\Partials\WindowHelpers.cs">
	    <ExcludeFromCurrentConfiguration>true</ExcludeFromCurrentConfiguration>
	  </Compile>
	</ItemGroup>
	
</Project>
